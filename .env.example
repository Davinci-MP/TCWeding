# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.
PORT=8787
NODE_ENV=development          # đặt production khi chạy sau HTTPS (bật cookie Secure)
DATA_DIR=data                 # nơi lưu SQLite + ảnh (gốc & bản hiển thị)
MAX_UPLOAD_MB=25
SESSION_DAYS=7
ALLOWED_ORIGINS=              # vd https://tcwedding.vn (cách nhau bằng dấu phẩy)
TRUST_PROXY=                  # số lớp proxy phía trước (Vercel + Render = 2); để trống khi chạy local

# Watermark: chỉ có tác dụng khi có file logo TCWedding (PNG nền trong suốt)
WATERMARK_ENABLED=false
WATERMARK_FILE=data/brand/watermark.png

# Tài khoản tạo tự động khi khởi động (nếu email chưa tồn tại)
ADMIN_EMAIL=admin@tcwedding.vn
ADMIN_PASSWORD=
ADMIN_NAME=Quản trị TCWedding
MARKETING_EMAIL=
MARKETING_PASSWORD=
SALE_EMAIL=
SALE_PASSWORD=

# Nhập ảnh vào album nháp từ Google Drive (Google Picker + Drive API)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
# Tùy chọn: đường dẫn ổ lưu trữ riêng cho ảnh WebP từ Drive.
# Mặc định nằm trong DATA_DIR/drive-media.
DRIVE_MEDIA_DIR=
