# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.

# SQLite: đường dẫn tính từ thư mục prisma/  → file nằm ở prisma/prod.db
DATABASE_URL="file:./prod.db"

# Chuỗi bí mật ký cookie đăng nhập — tạo bằng: openssl rand -base64 32
AUTH_SECRET=""

# Địa chỉ công khai của website (dùng cho link chia sẻ, ảnh xem trước Facebook/Zalo)
APP_URL="https://tcwedding.vn"

# Tài khoản quản trị tạo bởi `npm run db:seed` (production bắt buộc mật khẩu ≥ 10 ký tự)
ADMIN_EMAIL="admin@tcwedding.vn"
ADMIN_PASSWORD=""

# Chỉ đặt true nếu muốn tạo thêm tài khoản demo + thiệp mẫu /w/quan-ha trên production
SEED_DEMO="false"
