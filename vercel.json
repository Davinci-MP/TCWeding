{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://tcwedding-api.onrender.com/api/:path*" },
    { "source": "/media/:path*", "destination": "https://tcwedding-api.onrender.com/media/:path*" }
  ],
  "headers": [
    { "source": "/admin/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }, { "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
