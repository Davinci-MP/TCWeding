// SQLite cho phát triển. Khi lên production đổi provider = "postgresql"
// và DATABASE_URL tương ứng — schema không cần sửa gì thêm.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         String       @default("USER") // USER | ADMIN
  plan         String       @default("FREE") // FREE | PREMIUM
  createdAt    DateTime     @default(now())
  invitations  Invitation[]
}

model Invitation {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug       String   @unique
  title      String
  templateId String
  status     String   @default("DRAFT") // DRAFT | PUBLISHED
  data       String // JSON: InvitationData
  views      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  rsvps      Rsvp[]
  wishes     Wish[]
  order      Order?

  @@index([userId])
}

model Rsvp {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  attending    String // YES | NO | MAYBE
  guests       Int        @default(1)
  side         String? // GROOM | BRIDE
  note         String?
  createdAt    DateTime   @default(now())

  @@index([invitationId])
}

model Wish {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  name         String
  message      String
  hidden       Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([invitationId])
}

// Đơn đặt TCWedding làm thiệp hộ. Khách mở đơn bằng link bí mật /don/<token>, không cần tài khoản.
model Order {
  id               String         @id @default(cuid())
  token            String         @unique
  code             String         @unique // mã ngắn, dùng làm nội dung chuyển khoản
  status           String         @default("NEW") // xem src/lib/orders.ts
  contactName      String
  phone            String
  groom            String
  bride            String
  weddingDate      String // yyyy-mm-dd
  templateId       String
  details          String // khách mô tả: gia đình, lễ, địa điểm…
  price            Int // chốt theo giá lúc đặt (đồng)
  deposit          Int
  depositClaimedAt DateTime? // khách báo đã chuyển
  depositPaidAt    DateTime? // admin xác nhận đã nhận
  finalClaimedAt   DateTime?
  finalPaidAt      DateTime?
  claimedAt        DateTime? // khách đã nhận thiệp về tài khoản của mình
  adminNote        String         @default("")
  draft            String         @default("") // JSON InvitationData khách điền ở /thiep (trống = đơn cũ)
  extras           String         @default("") // JSON: thứ bậc, nhạc, slideshow, link ảnh, yêu cầu thêm
  visitorId        String         @default("") // khách ẩn danh: liên kết với mẫu khách đã thả tim
  invitationId     String?        @unique
  invitation       Invitation?    @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  photos           OrderPhoto[]
  messages         OrderMessage[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
}

model OrderPhoto {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())

  @@index([orderId])
}

model OrderMessage {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender    String // CUSTOMER | SHOP
  body      String
  createdAt DateTime @default(now())

  @@index([orderId])
}

// Cấu hình mẫu thiệp do admin chỉnh (bật/tắt, premium, thứ tự).
// Giao diện của mẫu nằm trong code: src/templates/registry.ts
model TemplateConfig {
  id        String  @id
  isActive  Boolean @default(true)
  isPremium Boolean @default(false)
  sortOrder Int     @default(0)
}

// Cài đặt chung của hệ thống do admin chỉnh (bảng giá…). value là JSON.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------- Studio ----------------

// Album ảnh. kind = COLLECTION: bộ sưu tập ảnh cưới (/bo-suu-tap).
// kind = SAMPLE: album in mẫu để khách lật xem (/album-mau), có khổ và phong cách.
model Album {
  id          String       @id @default(cuid())
  kind        String       @default("COLLECTION") // COLLECTION | SAMPLE
  slug        String       @unique
  title       String
  description String       @default("")
  category    String       @default("studio") // COLLECTION: studio | ngoai-canh | phong-su · SAMPLE: prewedding | phong-su | anh-phong
  location    String       @default("")
  size        String       @default("") // SAMPLE: khổ album, vd "30x30"
  coverUrl    String       @default("") // trống = ảnh đầu tiên
  status      String       @default("DRAFT") // DRAFT | PUBLISHED
  featured    Boolean      @default(false) // hiện ở trang chủ
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  photos      AlbumPhoto[]

  @@index([kind, status, sortOrder])
}

model AlbumPhoto {
  id        String @id @default(cuid())
  albumId   String
  album     Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url       String
  width     Int    @default(0)
  height    Int    @default(0)
  sortOrder Int    @default(0)

  @@index([albumId, sortOrder])
}

// Yêu cầu đặt lịch tư vấn từ form Liên hệ. Có thể kèm danh sách ảnh khách thả tim.
model Booking {
  id         String   @id @default(cuid())
  name       String
  phone      String
  shootDate  String   @default("") // yyyy-mm-dd, không bắt buộc
  service    String   @default("") // id gói chụp hoặc dịch vụ khác
  message    String   @default("")
  favorites  String   @default("[]") // JSON: [{ url, album, albumTitle }]
  status     String   @default("NEW") // NEW | CONTACTED | DONE | CANCELLED
  adminNote  String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
}

// Mẫu thiệp khách thả tim. Khách không cần tài khoản: nhận diện bằng cookie ẩn danh tcw_vid (1 năm).
model TemplateFavorite {
  id         String   @id @default(cuid())
  visitorId  String
  templateId String
  createdAt  DateTime @default(now())

  @@unique([visitorId, templateId])
  @@index([templateId])
}
