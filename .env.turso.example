# Sao chép thành .env.turso (KHÔNG commit), điền rồi chạy:
#   npm run turso:push   → tạo/cập nhật bảng trên Turso
#   npm run turso:seed   → tạo tài khoản admin trên Turso
TURSO_DATABASE_URL="libsql://ten-database-cua-ban.turso.io"
TURSO_AUTH_TOKEN=""

# Tài khoản admin của website thật (mật khẩu tối thiểu 10 ký tự)
NODE_ENV="production"
ADMIN_EMAIL="admin@tcwedding.vn"
ADMIN_PASSWORD=""
SEED_DEMO="false"
